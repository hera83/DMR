# Copy this file to .env and fill in the real values before running
# `docker compose up`. .env is gitignored — never commit your real secrets.

# --- Server ---
# Host port docker-compose publishes the API on (container always listens on
# 8080 internally).
PORT=8080

# --- Identity / API-key authentication (services/identity) ---
# Long random secret that authenticates as the Admin role — the only way to
# call the /Key endpoints (create/list/revoke/rollover regular API keys).
# Generate one with, e.g.: openssl rand -base64 32
Identity__MasterKey=

# Header name clients must send the API key (or master key) in.
Identity__HeaderName=X-Api-Key

# --- FTP (Danish Motor Register / Motorstyrelsen export, services/ftp) ---
Ftp__Host=
Ftp__Port=21
Ftp__Username=
Ftp__Password=
Ftp__UseEncryption=false
Ftp__RemoteBasePath=/
