# Compiled build output
bin/
obj/
*.dll
*.exe
*.pdb

# Any folder starting with a dot (.vscode, .docs, .vs, .idea, etc.)
.*/

# Local development settings
appsettings.Development.json

# Docker Compose secrets — copy .env.example to .env and fill it in locally
.env

# Runtime data — SQLite databases and FTP downloads/raws/scratch files.
# Created automatically (locally by the app, in Docker by entrypoint.sh) if missing.
app_dbs/**
app_files/downloads/**
app_files/temp/**
